# One image, four Lambda functions; template.yaml picks the handler with ImageConfig.Command.
FROM public.ecr.aws/lambda/python:3.12-arm64
COPY infra/requirements-lambda.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements-lambda.txt
COPY chowk ${LAMBDA_TASK_ROOT}/chowk
CMD ["chowk.aws.handlers.api_handler"]
